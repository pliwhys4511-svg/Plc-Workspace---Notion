# Server Port (defaults to 3000)
PORT="3000"

# Directory for persistent SQLite database storage (defaults to ./data)
PLC_DATA_DIR="./data"

# Optional access password for self-hosted deployments (leave empty for open workspace)
PLC_WORKSPACE_PASSWORD=""

# APP_URL: Public URL where this app is hosted
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional if extending with AI features later
GEMINI_API_KEY="MY_GEMINI_API_KEY"
